# Blood Donation System Environment Configuration Example
# Copy this file to .env and update the values

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/bloodDB
MONGODB_TEST_URI=mongodb://localhost:27017/bloodDB_test

# Server Ports
DONOR_PORT=5001
HOSPITAL_PORT=5002
ADMIN_PORT=5003
PUBLIC_STATS_PORT=5004

# Server Configuration
NODE_ENV=development
HOST=localhost

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Blood Donation System <noreply@blooddonation.com>

# SMS Configuration (Optional)
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_key_here_change_in_production

# External API Configuration
DONOR_MODULE_URL=http://localhost:5001
HOSPITAL_MODULE_URL=http://localhost:5002
ADMIN_MODULE_URL=http://localhost:5003
PUBLIC_STATS_URL=http://localhost:5004

# Search Configuration
DEFAULT_SEARCH_RADIUS=10000
MAX_SEARCH_RADIUS=50000

# Blood Types Configuration
BLOOD_TYPES=A+,A-,B+,B-,AB+,AB-,O+,O-

# Priority Levels
PRIORITY_LEVELS=Low,Medium,High,Critical

# Request Status
REQUEST_STATUS=Pending,Fulfilled,Cancelled

# Cache Configuration
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
